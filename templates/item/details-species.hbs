<section class="tab details {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="form-grid">
    <label data-tooltip="Health = this + TGH mod"><span>Base health</span><input type="number" name="system.health" value="{{system.health}}"></label>
    <label data-tooltip="Energy = this + CHA mod + INT mod"><span>Base energy</span><input type="number" name="system.energy" value="{{system.energy}}"></label>
    <label class="check"><input type="checkbox" name="system.playable" {{checked system.playable}}><span>Playable</span></label>
    <label class="check" data-tooltip="Only Mutants have mutations; the Abilities tab shows them only for a species with this ticked">
      <input type="checkbox" name="system.mutations" {{checked system.mutations}}><span>Carries mutations</span></label>
    <label class="check" data-tooltip="Only Humans take attribute boons; the Abilities tab shows them only for a species with this ticked">
      <input type="checkbox" name="system.boons" {{checked system.boons}}><span>Grants boons</span></label>
    <label class="check" data-tooltip="Grants the Paraphysical tag: the Abilities tab shows the Paraphysics panel">
      <input type="checkbox" name="system.paraphysical" {{checked system.paraphysical}}><span>Paraphysical</span></label>
    <label class="check" data-tooltip="Can never be paraphysically enabled by any means, Awakening included. The Paraphysics skill stays open for identification and knowledge"><input type="checkbox" name="system.noParaphysics" {{checked system.noParaphysics}}><span>Never paraphysical</span></label>
  </div>
  {{#if system.paraphysical}}
  {{!-- Paraphysics (2026-10-19): what it casts on, how many disciplines, and granted ranks. --}}
  <h4 class="section-title">Paraphysics</h4>
  <div class="form-grid">
    <label data-tooltip="Humans and Telestoi: Charisma. Reticulons: Intelligence"><span>Casts on</span><select name="system.paraphysics.attribute">{{selectOptions attributeOptions selected=system.paraphysics.attribute}}</select></label>
    <label data-tooltip="Humans 5, Reticulons 4, Telestoi 3"><span>Disciplines held, at most</span><input type="number" name="system.paraphysics.schools" value="{{system.paraphysics.schools}}" min="0" max="12"></label>
  </div>
  <p class="hint">Ranks granted in a discipline: free, and each raises that discipline's cap by one.</p>
  <div class="attr-block psi-bonus">
    {{#each speciesBonuses as |b|}}
    <label data-tooltip="{{b.label}}"><span class="mono-label">{{b.label}}</span><input type="number" name="system.paraphysics.bonus.{{b.key}}" value="{{b.value}}" min="0" max="5"></label>
    {{/each}}
  </div>
  {{/if}}
  <h4 class="section-title">Starting attributes</h4>
  <div class="attr-block">
    {{#each speciesAttributes as |a|}}
    <label data-tooltip="{{a.label}}"><span class="mono-label">{{a.abbr}}</span><input type="number" name="system.attributes.{{a.key}}" value="{{a.value}}"></label>
    {{/each}}
  </div>
  <p class="hint">Dropping this species on an operative offers to set its base attributes to this block.</p>
  {{!-- Species perks (Johnald, 2026-10-20): every character of the species gets all of them. --}}
  <fieldset class="background-perks">
    <legend>Species perks</legend>
    <p class="hint">Every character of this species gets all of these, at enlistment and when the species is dropped on a sheet.{{#if canEditPerks}} Drag abilities here from the Items sidebar, or make a new one; click a perk to edit it.{{/if}}</p>
    <ol class="perk-list" {{#if canEditPerks}}data-perk-drop{{/if}}>
      {{#each backgroundPerks as |p|}}
      <li class="perk-entry {{#if p.missing}}missing{{/if}}" data-perk-id="{{p.id}}">
        <img src="{{p.img}}" alt="">
        <a class="perk-name" data-action="openPerk" data-tooltip="Open the perk">{{p.name}}</a>
        {{#if p.missing}}<span class="perk-missing">Missing from the world</span>{{/if}}
        {{#if @root.canEditPerks}}<button type="button" class="icon" data-action="deletePerk" data-tooltip="Take it off the list (the ability itself stays)"><i class="fa-solid fa-xmark"></i></button>{{/if}}
      </li>
      {{else}}
      <li class="empty-row">No perks yet.</li>
      {{/each}}
    </ol>
    {{#if canEditPerks}}<button type="button" class="ghost" data-action="newPerk"><i class="fa-solid fa-plus"></i> New perk</button>{{/if}}
  </fieldset>
</section>
