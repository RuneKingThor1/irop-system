<section class="tab details {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="form-grid">
    <label><span>Attribute</span><select name="system.attribute">{{selectOptions attributes selected=system.attribute}}</select></label>
    <label><span>Amount</span><input type="number" name="system.amount" value="{{system.amount}}"></label>
  </div>
  <p class="hint">Human species bonus: two Attribute boons, each +10, never the same attribute twice.</p>
</section>
