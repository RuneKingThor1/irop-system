<section class="tab effects {{tab.cssClass}}" data-group="primary" data-tab="effects">
  <div class="panel">
    <header class="panel-head">
      <h3>Effects</h3>
      <span class="hint">Apply to the holder: mods while fitted, weapons and armor while equipped, gear while not stowed</span>
      {{#if editable}}<button type="button" class="ghost" data-action="createEffect"><i class="fa-solid fa-plus"></i> Add</button>{{/if}}
    </header>
    <ol class="item-list compact">
      {{#each effects as |e|}}
      <li class="item-row effect-row {{#if e.disabled}}disabled{{/if}}" data-effect-id="{{e.id}}">
        <div class="row-main">
          <img class="item-img" src="{{e.img}}" alt="">
          <div class="item-name"><a data-action="editEffect">{{e.name}}</a><span class="item-sub">{{e.changes}}</span></div>
          <div class="row-controls">
            <button type="button" class="icon {{#unless e.disabled}}on{{/unless}}" data-action="toggleEffect" data-tooltip="Enabled"><i class="fa-solid fa-power-off"></i></button>
            {{#if @root.editable}}<button type="button" class="icon" data-action="deleteEffect" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>{{/if}}
          </div>
        </div>
      </li>
      {{else}}
      <li class="empty-row">No effects. A perk like Resilience would add one here: system.vitals.hp.bonus, Add, 2.</li>
      {{/each}}
    </ol>
  </div>
</section>
