<section class="tab details {{tab.cssClass}}" data-group="primary" data-tab="details">
  <label class="wide-field"><span>Starting skills</span><input type="text" name="system.startingSkills" value="{{system.startingSkills}}" placeholder="Survivalism, Awareness, Mechanics, Technology, Stealth, Medical" data-tooltip="A new character picks the number below from this list"></label>
  <label class="wide-field" data-tooltip="How many of the listed skills a new character picks"><span>Skills to pick</span>
    <input type="number" name="system.skillPicks" value="{{system.skillPicks}}" min="0"></label>
  <p class="hint">If a background grants a skill the operative already has, raise that skill by one rank instead.</p>
  {{!-- The GM's call, so players never see it (Johnald, 2026-10-10). --}}
  {{#if isGM}}
  <label class="check" data-tooltip="Untick to keep it out of the enlistment terminal, without deleting it"><input type="checkbox" name="system.enlist" {{checked system.enlist}}><span>Offered at enlistment</span></label>
  <label class="wide-field" data-tooltip="The species it is offered to at enlistment, by name, comma separated. Blank for any"><span>Open to species</span>
    <input type="text" name="system.species" value="{{system.species}}" placeholder="Any species"></label>
  <label class="check" data-tooltip="Grants the Paraphysical tag: the Abilities tab shows the Paraphysics panel">
    <input type="checkbox" name="system.paraphysical" {{checked system.paraphysical}}><span>Paraphysical</span></label>
  {{/if}}

  {{!-- Background perks (Johnald, 2026-10-10): a new character takes one. Each is an ability, so it is
        written and changed as one; only a GM changes the list. --}}
  <fieldset class="background-perks">
    <legend>Background perks</legend>
    <p class="hint">A new character takes one of these.{{#if canEditPerks}} Drag abilities here from the Items sidebar, or make a new one; click a perk to edit it.{{/if}}</p>
    <ol class="perk-list" {{#if canEditPerks}}data-perk-drop{{/if}}>
      {{#each backgroundPerks as |p|}}
      <li class="perk-entry {{#if p.missing}}missing{{/if}}" data-perk-id="{{p.id}}">
        <img src="{{p.img}}" alt="">
        <a class="perk-name" data-action="openPerk" data-tooltip="Open the perk">{{p.name}}</a>
        {{#if p.missing}}<span class="perk-missing">Missing from the world</span>{{/if}}
        {{#if @root.canEditPerks}}<button type="button" class="icon" data-action="deletePerk" data-tooltip="Take it off the list (the ability itself stays)"><i class="fa-solid fa-xmark"></i></button>{{/if}}
      </li>
      {{else}}
      <li class="empty-row">No perks yet.</li>
      {{/each}}
    </ol>
    {{#if canEditPerks}}<button type="button" class="ghost" data-action="newPerk"><i class="fa-solid fa-plus"></i> New perk</button>{{/if}}
  </fieldset>
</section>
