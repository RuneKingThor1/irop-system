<section class="tab details {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="form-grid">
    <label><span>Class</span><select name="system.armorClass">{{selectOptions config.armorClasses selected=system.armorClass}}</select></label>
    <label data-tooltip="Some role perks scale with the tier of armor worn"><span>Tier</span><input type="number" name="system.tier" value="{{system.tier}}" min="0" max="9"></label>
    <label data-tooltip="Defense Value: added to every attack roll against the wearer (the old sheet's Armor Bonus)"><span>Defense</span><input type="number" name="system.defense" value="{{system.defense}}"></label>
    <label data-tooltip="Adaptive Armor: bonus HP added while worn (the old sheet's HP Bonus)"><span>Armor HP</span><input type="number" name="system.points" value="{{system.points}}"></label>
    <label data-tooltip="Added to the wearer's Barrier maximum while worn"><span>Barrier</span><input type="number" name="system.barrier" value="{{system.barrier}}" min="0"></label>
    <label data-tooltip="Extra dodges per round"><span>Dodges</span><input type="number" name="system.dodges" value="{{system.dodges}}"></label>
    <label data-tooltip="Blank uses the default for the class ({{defaultSlots}})"><span>Mod slots</span>
      <input type="number" name="system.modSlots" value="{{systemSource.modSlots}}" placeholder="{{defaultSlots}}"></label>
  </div>

  <h4 class="section-title">Mobility while worn: flat, per speed, usually +1 Run and +1 Sprint</h4>
  <div class="attr-block speeds">
    {{#each mobilityRows as |m|}}
    <label><span class="mono-label">{{m.label}}</span><input type="number" name="system.mobility.{{m.key}}" value="{{m.value}}"></label>
    {{/each}}
  </div>

  <h4 class="section-title">Damage reduction while worn</h4>
  <div class="dr-grid">
    {{#each drRows as |d|}}
    <label class="dr-cell {{#if d.value}}has{{/if}}"><span class="mono-label">{{d.label}}</span>
      <input type="number" name="system.dr.{{d.key}}" value="{{d.value}}"></label>
    {{/each}}
  </div>

  {{> "systems/irop/templates/item/physical.hbs"}}
  {{#if fitted}}<p class="hint">Fitted: {{fitted}}</p>{{/if}}
</section>
