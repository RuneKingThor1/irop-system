<div class="irop-dialog attack-dialog">
  <div class="attack-head">
    <img src="{{img}}" alt="">
    <div>
      <strong>{{itemName}}</strong>
      <span class="hint">against {{targetLabel}} · accuracy D.M. {{accuracyText}}{{#if ammo}} · ammo {{ammo}}{{/if}}</span>
      {{#if ammoName}}<span class="hint loaded-ammo">Loaded: {{ammoName}}</span>{{/if}}
    </div>
  </div>

  <fieldset class="choice-row">
    <legend>Target's cover</legend>
    {{#each covers as |c|}}
    <label class="pill"><input type="radio" name="cover" value="{{c.key}}" {{checked c.checked}}><span>{{c.label}} <em>{{c.value}}</em></span></label>
    {{/each}}
  </fieldset>

  {{#if ranges}}
  <fieldset class="choice-row">
    <legend>Range band</legend>
    {{#each ranges as |r|}}
    <label class="pill"><input type="radio" name="range" value="{{r.key}}" {{checked r.checked}}><span>{{r.label}}</span></label>
    {{/each}}
  </fieldset>
  {{/if}}

  {{!-- RULED 2026-10-07: the target's Defense (worn armor) goes on the roll by itself. Untick only for an attack that ignores armor.
        Area weapons need no target (2026-10-08): with none, or several, there is no Defense line.
        Below cover and range, above Battlefield (Johnald, 2026-10-10). --}}
  <fieldset class="toggle-list target-defense">
    <legend>Target</legend>
    {{#if target.single}}
    <label data-tooltip="Added to the roll from {{target.name}}'s worn armor. Untick for an attack that ignores armor.">
      <input type="checkbox" name="defense" {{#unless target.ignoredBy}}checked{{/unless}}><span>{{target.name}}'s Defense{{#if target.ignoredBy}} (ignored by {{target.ignoredBy}}){{/if}}</span><em>{{target.defenseText}}</em></label>
    {{else if target.name}}
    <p class="hint">In the blast: {{target.name}}. No Defense added.</p>
    {{else}}
    <p class="hint">No target: aimed at an area.</p>
    {{/if}}
  </fieldset>

  <fieldset class="toggle-list">
    <legend>Battlefield</legend>
    {{#each toggles as |t|}}
    <label data-tooltip="{{t.hint}}"><input type="checkbox" name="mod.{{t.key}}" {{checked t.checked}}><span>{{t.label}}</span><em>{{t.value}}</em></label>
    {{/each}}
  </fieldset>

  {{#if power}}
  {{!-- A power's own lines (Paraphysics Framework Draft 0.6, 2026-10-19). --}}
  <fieldset class="toggle-list psi-list">
    <legend>Paraphysics</legend>
    {{#if power.track}}<p class="perk-auto"><i class="fa-solid fa-check"></i> Power rank {{power.rank}}: Accuracy {{power.trackText}}</p>{{/if}}
    <div class="choice-row psi-range">
      <label class="pill" data-tooltip="Twice your casting modifier"><input type="radio" name="psi.range" value="in" checked><span>In optimal range{{#if power.range}} ({{power.range}} tiles){{/if}} <em>{{power.optimalText}}</em></span></label>
      <label class="pill"><input type="radio" name="psi.range" value="out"><span>Out of optimal range <em>{{power.outOfRangeText}}</em></span></label>
    </div>
    {{#if power.focusValue}}
    <label data-tooltip="A focus and the power's Accuracy share a -25 ceiling.">
      <input type="checkbox" name="psi.focus" {{checked power.hasFocus}}><span>Paraphysical focus{{#unless power.hasFocus}} (none carried){{/unless}}</span><em>{{power.focusText}}</em></label>
    {{/if}}
    {{#if power.concentration}}<p class="hint">Concentration: Disorientated breaks it.</p>{{/if}}
  </fieldset>
  {{/if}}
  {{#if perks.any}}
  {{!-- Role perks (2026-10-18): applied on their own, ticked for what the system cannot see, counted. --}}
  <fieldset class="toggle-list perk-list">
    <legend>Perks</legend>
    {{#each perks.auto as |p|}}<p class="perk-auto"><i class="fa-solid fa-check"></i> {{p.text}}</p>{{/each}}
    {{#each perks.situations as |t|}}
    <label data-tooltip="{{t.text}}"><input type="checkbox" name="perk.{{t.key}}" {{checked t.checked}}><span>{{t.label}}</span><em>{{t.text}}</em></label>
    {{/each}}
    {{#each perks.scales as |t|}}
    <label class="row perk-scale" data-tooltip="{{t.text}}"><span>{{t.label}}</span><input type="number" name="perkCount.{{t.key}}" value="0" min="0" max="{{t.max}}" step="1"></label>
    {{/each}}
  </fieldset>
  {{/if}}
  {{#if through}}<p class="hint through-ability"><i class="fa-solid fa-bolt"></i> {{through.name}}{{#if through.accuracyText}}: {{through.accuracyText}} to hit{{/if}}{{#if through.autoHit}}, cannot miss{{/if}}{{#if through.noCrit}}, no critical{{/if}}{{#if through.ammo}}, {{through.ammo}} ammo{{/if}}</p>{{/if}}
  <label class="row"><span>Situational D.M.</span><input type="number" name="dm" value="0" step="5"></label>
  <label class="row"><span>Roll mode</span>
    <select name="mode">{{selectOptions modes selected=mode valueAttr="value" labelAttr="label"}}</select></label>
</div>
