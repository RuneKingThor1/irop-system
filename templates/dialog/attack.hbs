<div class="irop-dialog attack-dialog">
  <div class="attack-head">
    <img src="{{img}}" alt="">
    <div>
      <strong>{{itemName}}</strong>
      <span class="hint">against {{targetLabel}} · accuracy D.M. {{accuracyText}}{{#if ammo}} · ammo {{ammo}}{{/if}}</span>
      {{#if ammoName}}<span class="hint loaded-ammo">Loaded: {{ammoName}}</span>{{/if}}
    </div>
  </div>

  <fieldset class="choice-row">
    <legend>Target's cover</legend>
    {{#each covers as |c|}}
    <label class="pill"><input type="radio" name="cover" value="{{c.key}}" {{checked c.checked}}><span>{{c.label}} <em>{{c.value}}</em></span></label>
    {{/each}}
  </fieldset>

  {{#if ranges}}
  <fieldset class="choice-row">
    <legend>Range band</legend>
    {{#each ranges as |r|}}
    <label class="pill"><input type="radio" name="range" value="{{r.key}}" {{checked r.checked}}><span>{{r.label}}</span></label>
    {{/each}}
  </fieldset>
  {{/if}}

  {{!-- RULED 2026-10-07: the target's Defense (worn armor) goes on the roll by itself. Untick only for an attack that ignores armor.
        Area weapons need no target (2026-10-08): with none, or several, there is no Defense line.
        Below cover and range, above Battlefield (Johnald, 2026-10-10). --}}
  <fieldset class="toggle-list target-defense">
    <legend>Target</legend>
    {{#if target.single}}
    <label data-tooltip="Added to the roll from {{target.name}}'s worn armor. Untick for an attack that ignores armor.">
      <input type="checkbox" name="defense" {{#unless target.ignoredBy}}checked{{/unless}}><span>{{target.name}}'s Defense{{#if target.ignoredBy}} (ignored by {{target.ignoredBy}}){{/if}}</span><em>{{target.defenseText}}</em></label>
    {{else if target.name}}
    <p class="hint">In the blast: {{target.name}}. No Defense added.</p>
    {{else}}
    <p class="hint">No target: aimed at an area.</p>
    {{/if}}
  </fieldset>

  <fieldset class="toggle-list">
    <legend>Battlefield</legend>
    {{#each toggles as |t|}}
    <label data-tooltip="{{t.hint}}"><input type="checkbox" name="mod.{{t.key}}" {{checked t.checked}}><span>{{t.label}}</span><em>{{t.value}}</em></label>
    {{/each}}
  </fieldset>

  <label class="row"><span>Situational D.M.</span><input type="number" name="dm" value="0" step="5"></label>
  <label class="row"><span>Roll mode</span>
    <select name="mode">{{selectOptions modes selected=mode valueAttr="value" labelAttr="label"}}</select></label>
</div>
