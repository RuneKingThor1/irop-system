<div class="irop-dialog">
  <p class="lede">Dodge: d100, meet or roll under <strong>{{targetLabel}}</strong>. Dodges left this round: {{dodgesLeft}} of {{dodgesMax}}.</p>
  <fieldset class="choice-row">
    <legend>Your cover (dodge column)</legend>
    {{#each covers as |c|}}
    <label class="pill"><input type="radio" name="cover" value="{{c.key}}" {{checked c.checked}}><span>{{c.label}}</span></label>
    {{/each}}
  </fieldset>
  <fieldset class="toggle-list">
    <label><input type="checkbox" name="unaware"><span>Unaware</span><em>you dodge as if in the open (+30)</em></label>
    <label><input type="checkbox" name="disorientated" {{checked disorientated}}><span>Disorientated</span><em>+20</em></label>
  </fieldset>
  {{#if perks.any}}
  {{!-- Role perks (2026-10-18): applied on their own, ticked for what the system cannot see, counted. --}}
  <fieldset class="toggle-list perk-list">
    <legend>Perks</legend>
    {{#each perks.auto as |p|}}<p class="perk-auto"><i class="fa-solid fa-check"></i> {{p.text}}</p>{{/each}}
    {{#each perks.situations as |t|}}
    <label data-tooltip="{{t.text}}"><input type="checkbox" name="perk.{{t.key}}" {{checked t.checked}}><span>{{t.label}}</span><em>{{t.text}}</em></label>
    {{/each}}
    {{#each perks.scales as |t|}}
    <label class="row perk-scale" data-tooltip="{{t.text}}"><span>{{t.label}}</span><input type="number" name="perkCount.{{t.key}}" value="0" min="0" max="{{t.max}}" step="1"></label>
    {{/each}}
  </fieldset>
  {{/if}}
  <label class="row"><span>Situational D.M.</span><input type="number" name="dm" value="0" step="5"></label>
  <label class="row"><span>Roll mode</span>
    <select name="mode">{{selectOptions modes selected=mode valueAttr="value" labelAttr="label"}}</select></label>
</div>
