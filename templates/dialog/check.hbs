<div class="irop-dialog">
  <p class="lede">d100, meet or roll under <strong>{{targetLabel}}</strong>.</p>
  <label class="row"><span>Situational D.M.</span>
    <input type="number" name="dm" value="0" step="5" autofocus>
    <em class="hint">negative is easier, positive is harder</em></label>
  <label class="row"><span>Roll mode</span>
    <select name="mode">{{selectOptions modes selected=mode valueAttr="value" labelAttr="label"}}</select></label>
</div>
