<div class="en-body">
  {{!-- The enlistment terminal (Johnald, 2026-10-12, mockup A): steps, cards, and the draft record. --}}
  <nav class="en-rail" aria-label="Enlistment steps">
    <div class="en-boot">ODR // ARTEMIS<br>link <b>secure</b><br>recruit file <b>{{#if result}}filed{{else}}open{{/if}}</b></div>
    {{#each steps as |s|}}
    <button type="button" class="en-step {{#if s.on}}on{{/if}} {{#if s.done}}done{{/if}} {{#if s.warn}}warn{{/if}}" data-action="goStep" data-index="{{s.index}}" {{#if @root.result}}disabled{{/if}}>
      <span class="n">{{s.n}}</span><span class="t">{{s.label}}</span><span class="v">{{s.value}}</span>
    </button>
    {{/each}}
    {{#if hasStores}}
    {{!-- Requisition (2026-10-16): the stores the GM opened, once the record is filed. --}}
    <button type="button" class="en-step en-step-req {{#if requisition.on}}on{{/if}}" data-action="requisition" {{#unless result}}disabled{{/unless}}>
      <span class="n">{{reqNo}}</span><span class="t">Requisition</span><span class="v">{{#if result}}Starting kit{{else}}After filing{{/if}}</span>
    </button>
    {{/if}}
  </nav>

  <div class="en-main">
    {{#if requisition.on}}
    {{!-- Requisition (2026-10-16): each store opens in its own window, buying for the recruit. --}}
    {{#with requisition}}
    <div class="en-prompt"><span class="en-prompt-text">&gt; DRAW STARTING KIT</span><span class="en-caret"></span></div>
    <div class="en-pane">
      <h3>Requisition</h3>
      <p class="en-sub">Buy {{name}}'s starting kit. Each store opens in its own window, buying for {{name}}. Anything bought by mistake can be refunded from its card in chat.</p>
      <div class="en-block en-wallet"><span class="en-label">Purse</span>
        {{#each wallet as |w|}}<span class="en-coin {{w.key}}"><span>{{w.label}}</span><b>{{w.value}}</b></span>{{/each}}</div>
      {{#if closed.length}}<p class="hint warn">Players cannot open {{#each closed}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} yet. Give them at least Limited on the store.</p>{{/if}}
      <div class="en-grid en-stores">
        {{#each stores as |s|}}
        <button type="button" class="en-card en-store" style="--c: var(--irop-gold, #d9b234)" data-action="openStore" data-id="{{s.id}}">
          <span class="en-card-top"><img class="en-thumb" src="{{s.img}}" alt=""><span><span class="en-name">{{s.name}}</span><span class="en-blurb">{{s.count}} on the shelf</span></span></span>
          {{#if s.blurb}}<span class="en-blurb">{{s.blurb}}</span>{{/if}}
          <span class="en-row"><span class="k">Open</span><i class="fa-solid fa-store"></i> Shop here</span>
        </button>
        {{else}}<p class="en-empty">No store is open to you yet. Ask the GM.</p>{{/each}}
      </div>
      <div class="en-block en-kit"><span class="en-label">Kit carried</span>
        {{#if kit.length}}<div class="en-kit-list">{{#each kit as |k|}}<span><img src="{{k.img}}" alt="">{{k.name}}{{#if (gt k.qty 1)}} <em>&times;{{k.qty}}</em>{{/if}}</span>{{/each}}</div>
        {{else}}<p class="en-empty">Nothing yet.</p>{{/if}}</div>
      <div class="en-foot">
        <button type="button" class="ghost" data-action="record">Back to the record</button>
        <button type="button" class="go" data-action="openSheet"><i class="fa-solid fa-id-badge"></i> Done, open {{name}}'s sheet</button>
      </div>
    </div>
    {{/with}}
    {{else if result}}
    {{!-- Enlisted: the record printed and stamped. --}}
    {{#with result}}
    <div class="en-pane en-finish">
      <div class="en-record">
        <div class="en-rec-head"><b>Eclipse personnel record</b><span>Filed</span></div>
        <div class="en-rec-grid">
          <div class="en-rec-photo" style="border-color: {{color}}"><img src="{{img}}" alt=""></div>
          <dl class="en-rec-kv">
            <dt>Name</dt><dd>{{#if first}}{{first}} {{last}}{{else}}{{name}}{{/if}}</dd>
            <dt>Callsign</dt><dd>{{#if callsign}}{{callsign}}{{else}}None{{/if}}</dd>
            <dt>Species</dt><dd>{{species}}</dd>
            <dt>Doctrine</dt><dd style="color: {{color}}">{{role}}</dd>
          </dl>
          <dl class="en-rec-kv">
            <dt>Background</dt><dd>{{background}}</dd>
            {{#if perk}}<dt>Perk</dt><dd>{{perk}}</dd>{{/if}}
            {{#if mutations}}<dt>Mutations</dt><dd>{{mutations}}</dd>{{/if}}
            {{#if boons}}<dt>Boons</dt><dd>{{boons}}</dd>{{/if}}
            {{#if training}}<dt>Training</dt><dd>{{training}}</dd>{{/if}}
            <dt>Assignment</dt><dd>Eclipse</dd>
          </dl>
        </div>
        <div class="en-rec-log">{{#if enlisted}}<b>{{enlisted}}</b>{{/if}}Enlisted with Eclipse. Starting skills: {{skills}}.</div>
        <div class="en-stamp">Enlisted<small>ODR command</small></div>
      </div>
      <div class="en-foot">
        <button type="button" class="ghost" data-action="restamp">Stamp again</button>
        <button type="button" class="ghost" data-action="again">Enlist another</button>
        {{#if @root.requisition.any}}
        <button type="button" class="ghost" data-action="openSheet">Open {{name}}'s sheet</button>
        <button type="button" class="go" data-action="requisition"><i class="fa-solid fa-store"></i> Requisition</button>
        {{else}}
        <button type="button" class="go" data-action="openSheet"><i class="fa-solid fa-id-badge"></i> Open {{name}}'s sheet</button>
        {{/if}}
      </div>
    </div>
    {{/with}}
    {{else}}
    <div class="en-prompt"><span class="en-prompt-text">&gt; {{prompt}}</span><span class="en-caret"></span></div>
    <div class="en-pane {{#if slide}}en-slide{{/if}}">

      {{#if is.species}}
      <h3>Species</h3>
      <p class="en-sub">Sets your base attributes, health and energy. Each attribute is shown against the human baseline.</p>
      <div class="en-grid">
        {{#each species as |s|}}
        <button type="button" class="en-card {{#if s.on}}on{{/if}}" style="--c: var(--irop-sky)" data-action="pick" data-kind="species" data-id="{{s.id}}" aria-pressed="{{#if s.on}}true{{else}}false{{/if}}">
          <span class="en-card-top"><img class="en-thumb" src="{{s.img}}" alt=""><span><span class="en-name">{{s.name}}</span><span class="en-blurb">{{s.blurb}}</span></span></span>
          <span class="en-row"><span class="k">Health / energy</span>{{s.health}} / {{s.energy}}{{#each s.tags as |t|}}. {{t}}{{/each}}</span>
          <span class="en-stats">{{#each s.attributes as |a|}}<span class="{{#if (gt a.diff 0)}}hi{{/if}}{{#if (lt a.diff 0)}}lo{{/if}}">{{a.abbr}}<b>{{a.value}}</b></span>{{/each}}</span>
        </button>
        {{else}}<p class="en-empty">No playable species in this world yet. The GM adds them to the Items sidebar.</p>{{/each}}
      </div>
      {{/if}}

      {{#if is.role}}
      <h3>Doctrine</h3>
      <p class="en-sub">Your role sets your starting skills, the weapons you train with, and the perk trees you grow into.</p>
      <div class="en-grid">
        {{#each roles as |r|}}
        <button type="button" class="en-card {{#if r.on}}on{{/if}}" style="--c: {{r.color}}" data-action="pick" data-kind="role" data-id="{{r.id}}" aria-pressed="{{#if r.on}}true{{else}}false{{/if}}">
          <span class="en-card-top"><span class="en-hex">{{r.abbr}}</span><span class="en-name">{{r.name}}</span></span>
          <span class="en-blurb">{{r.blurb}}</span>
          {{#if r.free}}<span class="en-row"><span class="k">Starting skills</span><span class="free">{{r.free}}</span>{{#if r.options}}, then {{r.options}}{{/if}}</span>{{/if}}
          {{#if r.weapons}}<span class="en-row"><span class="k">Weapons</span>{{r.weapons}}</span>{{/if}}
        </button>
        {{else}}<p class="en-empty">No roles in this world yet.</p>{{/each}}
      </div>
      {{/if}}

      {{#if is.background}}
      <h3>Background</h3>
      <p class="en-sub">Who you were before Eclipse. You pick some of its skills, and one of its perks.</p>
      <div class="en-grid">
        {{#each backgrounds as |b|}}
        <button type="button" class="en-card {{#if b.on}}on{{/if}}" style="--c: var(--irop-teal, #3fb8b0)" data-action="pick" data-kind="background" data-id="{{b.id}}" aria-pressed="{{#if b.on}}true{{else}}false{{/if}}">
          <span class="en-card-top"><img class="en-thumb" src="{{b.img}}" alt=""><span class="en-name">{{b.name}}</span></span>
          {{#if b.blurb}}<span class="en-blurb">{{b.blurb}}</span>{{/if}}
          {{#if b.skills}}<span class="en-row"><span class="k">Skills, pick {{b.pick}}</span>{{b.skills}}</span>{{/if}}
          {{#if b.perks.length}}<span class="en-perks">{{#each b.perks as |p|}}<span>{{p}}</span>{{/each}}</span>{{/if}}
          {{#if b.paraphysical}}<span class="en-row"><span class="k">Paraphysical</span>Opens the Paraphysics panel</span>{{/if}}
        </button>
        {{else}}<p class="en-empty">No backgrounds in this world yet.</p>{{/each}}
      </div>
      {{/if}}

      {{#if is.skills}}
      <h3>Skills and perk</h3>
      <p class="en-sub">Each skill picked goes up one rank. One taken from both goes up two.</p>
      {{#with skills}}
      <div class="en-block">
        <span class="en-label">{{role.name}}: {{#if role.free.length}}one free{{/if}}{{#if role.pick}}, pick {{role.pick}} more{{/if}}</span>
        <div class="en-chips">
          {{#each role.free as |f|}}<span class="en-chip fixed">{{f.label}}, free</span>{{/each}}
          {{#each role.options as |o|}}<button type="button" class="en-chip {{#if o.on}}on{{/if}}" data-action="roleSkill" data-skill="{{o.key}}">{{o.label}}</button>{{/each}}
        </div>
      </div>
      <div class="en-block">
        <span class="en-label">{{background.name}}: pick {{background.pick}} ({{background.count}} of {{background.pick}})</span>
        <div class="en-chips">
          {{#each background.options as |o|}}<button type="button" class="en-chip {{#if o.on}}on{{/if}}" data-action="backgroundSkill" data-skill="{{o.key}}">{{o.label}}</button>{{/each}}
        </div>
      </div>
      {{#if perks.length}}
      <div class="en-block">
        <span class="en-label">{{background.name}}: one background perk</span>
        <div class="en-perk-list">
          {{#each perks as |p|}}
          <div role="button" tabindex="0" class="en-perk {{#if p.on}}on{{/if}}" data-action="perk" data-perk="{{p.id}}" aria-pressed="{{#if p.on}}true{{else}}false{{/if}}">
            <img src="{{p.img}}" alt="">
            <span class="en-perk-body"><span class="en-perk-name">{{p.name}}</span>{{#if p.meta}}<span class="en-perk-meta">{{p.meta}}</span>{{/if}}
              {{#if p.missing}}<span class="en-perk-meta">Its ability is missing from this world. The GM can fix the background.</span>{{/if}}
              <div class="en-perk-text">{{{p.description}}}</div></span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{else}}<p class="en-empty">Choose a role and a background first.</p>{{/with}}
      {{/if}}

      {{#if is.boons}}
      {{!-- Boons (2026-10-16): a species that grants them picks two attributes, none twice. --}}
      <h3>Boons</h3>
      <p class="en-sub">Your species grants {{boons.picks}} Attribute boons, each +{{boons.amount}} to an attribute you choose. Not the same attribute twice. ({{boons.count}} of {{boons.picks}} picked)</p>
      <div class="en-grid en-boons">
        {{#each boons.options as |b|}}
        <button type="button" class="en-card en-boon {{#if b.on}}on{{/if}}" style="--c: var(--irop-good)" data-action="boon" data-attribute="{{b.key}}" aria-pressed="{{#if b.on}}true{{else}}false{{/if}}">
          <span class="en-card-top"><span class="en-hex">{{b.abbr}}</span><span class="en-name">{{b.label}}</span></span>
          <span class="en-boon-value">{{b.value}} <i class="fa-solid fa-arrow-right"></i> <b>{{b.after}}</b></span>
          {{#if b.item}}<span class="en-blurb">{{b.item}}</span>{{/if}}
        </button>
        {{/each}}
      </div>
      {{/if}}

      {{#if is.mutations}}
      {{!-- Mutations (2026-10-16): the Baron's rolls, for a species that carries them. --}}
      <h3>Mutations</h3>
      <p class="en-sub">Roll twice on the Positive table and once on the Negative. A duplicate Positive is rerolled, and the Negative may be rerolled once. Every roll goes to chat.</p>
      {{#with mutations}}
      {{#if ready}}
      {{#if rolled}}
      <div class="en-mut-list">
        {{#each chosen as |m|}}
        <div class="en-mut {{m.polarity}}"><img src="{{m.img}}" alt="">
          <span class="en-mut-body"><span class="en-mut-head"><span class="en-mut-roll">{{m.label}} {{m.n}}</span><span class="en-perk-name">{{m.name}}</span></span>
            <div class="en-perk-text">{{{m.description}}}</div></span></div>
        {{/each}}
      </div>
      <div class="en-block en-mut-log"><span class="en-label">Rolls</span>{{#each log as |l|}}<p>{{l}}</p>{{/each}}</div>
      {{#if canReroll}}<button type="button" class="ghost en-reroll" data-action="rerollNegative"><i class="fa-solid fa-rotate"></i> Reroll the Negative, once</button>
      {{else}}{{#if rerolled}}<p class="hint">The Negative was rerolled; the second outcome stands.</p>{{/if}}{{/if}}
      {{else}}
      <button type="button" class="en-roll" data-action="rollMutations"><i class="fa-solid fa-dice-d20"></i> Roll mutations</button>
      {{/if}}
      <p class="hint">{{#if fromTables}}Rolled on the world's Positive and Negative mutations (d20) tables.{{else}}This world has no mutation roll tables, so each mutation of the kind is equally likely.{{/if}}</p>
      {{else}}
      <p class="en-empty">This world has no player mutations yet. The GM runs the player mutations macro, then this step can roll.</p>
      {{/if}}
      {{/with}}
      {{/if}}

      {{#if is.training}}
      {{!-- Training (2026-10-16): the first XP, planned here and spent at Enlist. --}}
      <h3>Training</h3>
      <p class="en-sub">You start with {{training.budget}} XP. Spend it on attribute ranks (+{{training.perRank}} each), skill ranks and perks, at the Training tab's prices. Nothing is spent until you enlist, and what you leave stays unspent for later.</p>
      {{#with training}}
      <div class="en-xp">
        <span class="en-label">Training XP</span>
        <span class="en-xp-meter"><span style="width: {{pct}}%"></span></span>
        <span class="en-xp-left"><b>{{left}}</b> of {{budget}} left</span>
        {{#if any}}<button type="button" class="ghost" data-action="resetTraining"><i class="fa-solid fa-rotate-left"></i> Reset</button>{{/if}}
      </div>
      <div class="en-train-cols">
        <div class="en-block"><span class="en-label">Attributes</span>
          {{#each attributes as |a|}}
          <div class="en-train-row {{#if a.bought}}bought{{/if}}">
            <span class="en-tr-name">{{a.label}}</span><b class="en-tr-value">{{a.value}}</b>
            <span class="en-pips">{{#each a.pips as |p|}}<i class="{{#if p.bought}}bought{{/if}}"></i>{{/each}}</span>
            <button type="button" class="en-tr-btn" data-action="trainAttribute" data-key="{{a.key}}" data-delta="-1" {{#unless a.canDrop}}disabled{{/unless}} aria-label="{{a.label}}, one rank less"><i class="fa-solid fa-minus"></i></button>
            <button type="button" class="en-tr-btn" data-action="trainAttribute" data-key="{{a.key}}" data-delta="1" {{#unless a.canAdd}}disabled{{/unless}} aria-label="{{a.label}}, one rank more"><i class="fa-solid fa-plus"></i></button>
            <span class="en-tr-cost">{{#if a.next}}{{a.next}} XP{{else}}Top{{/if}}</span>
          </div>
          {{/each}}
        </div>
        <div class="en-block"><span class="en-label">Skills</span>
          <div class="en-train-skills">
          {{#each skills as |s|}}
          <div class="en-train-row {{#if s.bought}}bought{{/if}} {{#unless s.has}}untrained{{/unless}}">
            <span class="en-tr-name" data-tooltip="{{s.label}}">{{s.label}}</span>
            <span class="en-pips">{{#each s.pips as |p|}}<i class="{{#if p.start}}start{{/if}} {{#if p.bought}}bought{{/if}}"></i>{{/each}}</span>
            <button type="button" class="en-tr-btn" data-action="trainSkill" data-key="{{s.key}}" data-delta="-1" {{#unless s.canDrop}}disabled{{/unless}} aria-label="{{s.label}}, one rank less"><i class="fa-solid fa-minus"></i></button>
            <button type="button" class="en-tr-btn" data-action="trainSkill" data-key="{{s.key}}" data-delta="1" {{#unless s.canAdd}}disabled{{/unless}} aria-label="{{s.label}}, one rank more"><i class="fa-solid fa-plus"></i></button>
            <span class="en-tr-cost">{{#if s.next}}{{s.next}} XP{{else}}Top{{/if}}</span>
          </div>
          {{/each}}
          </div>
        </div>
      </div>
      {{#if active}}
      {{!-- Each tree on its own tab (2026-10-16); a role's own tree offers its first tiers here. --}}
      <div class="en-block en-train-tree">
        <nav class="en-tree-tabs" aria-label="Perk trees">
          {{#each trees as |t|}}<button type="button" class="en-tree-tab {{#if t.on}}on{{/if}}" data-action="perkTab" data-tree="{{t.id}}" aria-pressed="{{#if t.on}}true{{else}}false{{/if}}">{{t.label}}{{#if t.taken}} <b>{{t.taken}}</b>{{/if}}</button>{{/each}}
        </nav>
        {{#with active as |t|}}
        {{#if t.limited}}<p class="hint">At enlistment, the first {{@root.training.roleTiers}} tiers. The rest open on your sheet's Training tab.</p>{{/if}}
        {{#each t.tiers as |tier|}}
        <div class="en-tier">
          {{#if tier.gated}}<span class="en-tier-head">Tier {{tier.number}}{{#if tier.exclusive}}, pick one{{/if}}</span>{{else if tier.exclusive}}<span class="en-tier-head">Pick one</span>{{/if}}
          <div class="en-tperks">
            {{#each tier.nodes as |p|}}
            <div role="button" tabindex="0" class="en-tperk {{p.state}} {{#if p.on}}on{{/if}} {{#if p.canBuy}}can{{/if}}" data-action="trainPerk" data-node="{{p.id}}" aria-pressed="{{#if p.on}}true{{else}}false{{/if}}">
              <img src="{{p.img}}" alt="">
              <span class="en-perk-body"><span class="en-perk-name">{{p.name}}</span>
                <span class="en-perk-meta">{{p.cost}} XP{{#if p.meta}}, {{p.meta}}{{/if}}</span>
                {{#if p.blurb}}<span class="en-tperk-text">{{p.blurb}}</span>{{/if}}
                {{#unless p.on}}{{#unless p.canBuy}}<span class="en-tperk-why">{{p.reason}}</span>{{/unless}}{{/unless}}</span>
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}
        {{/with}}
      </div>
      {{else}}
      <p class="en-empty">No perk trees for this role in this world yet, so only attributes and skills can be trained here.</p>
      {{/if}}
      {{/with}}
      {{/if}}

      {{#if is.identity}}
      <h3>Identity</h3>
      <p class="en-sub">Your record keeps your full name. Your sheet and token go by your callsign, or your name if you have none.</p>
      <div class="en-block en-identity">
        <div class="en-fields">
          <label><span class="en-label">First name</span><input type="text" data-field="firstName" value="{{identity.firstName}}" autocomplete="off"></label>
          <label><span class="en-label">Last name</span><input type="text" data-field="lastName" value="{{identity.lastName}}" autocomplete="off"></label>
          <label><span class="en-label">Callsign</span><input type="text" data-field="callsign" value="{{identity.callsign}}" autocomplete="off"></label>
          {{#if identity.owners.length}}
          <label><span class="en-label">For</span><select data-field="owner">{{#each identity.owners as |o|}}<option value="{{o.id}}" {{#if o.on}}selected{{/if}}>{{o.name}}</option>{{/each}}</select></label>
          {{/if}}
        </div>
        <div class="en-portrait-pick">
          <span class="en-label">Portrait</span>
          <img src="{{identity.img}}" alt="">
          <button type="button" class="ghost" data-action="browse"><i class="fa-solid fa-image"></i> Choose an image</button>
        </div>
      </div>
      {{/if}}

      {{#if is.review}}
      <h3>Review</h3>
      <p class="en-sub">Check your file. Enlisting makes the operative and hands it to you.</p>
      {{#if review.length}}
      <div class="en-block en-issues">{{#each review as |r|}}<p><b>{{r.step}}:</b> {{r.text}}</p>{{/each}}</div>
      {{else}}
      <div class="en-block">
        <dl class="en-kv">
          <dt>Name</dt><dd>{{dossier.name}}</dd>
          <dt>Species</dt><dd>{{dossier.species}}</dd>
          <dt>Role</dt><dd style="color: {{dossier.color}}">{{dossier.role}}</dd>
          <dt>Background</dt><dd>{{dossier.background}}{{#if dossier.perk}}, {{dossier.perk}}{{/if}}</dd>
          <dt>Skills</dt><dd>{{dossier.skills}}</dd>
          {{#if dossier.mutations}}<dt>Mutations</dt><dd>{{dossier.mutations}}</dd>{{/if}}
          {{#if dossier.boons}}<dt>Boons</dt><dd>{{dossier.boons}}</dd>{{/if}}
          <dt>Training</dt><dd>{{#if dossier.training}}{{dossier.training}}{{else}}None yet{{/if}}</dd>
          {{#if dossier.xp}}<dt>XP</dt><dd>{{dossier.xp}}</dd>{{/if}}
        </dl>
      </div>
      {{/if}}
      {{/if}}

      <div class="en-foot">
        {{#if issue}}<span class="en-issue">{{issue}}</span>{{else}}<span class="en-hint">Step {{stepNo}} of {{stepCount}}</span>{{/if}}
        {{#unless first}}<button type="button" class="ghost" data-action="back">Back</button>{{/unless}}
        {{#if last}}
        <button type="button" class="go" data-action="enlist" {{#if waiting}}disabled{{/if}}>{{#if waiting}}Filing with the GM...{{else}}<i class="fa-solid fa-stamp"></i> Enlist{{/if}}</button>
        {{else}}
        <button type="button" class="go" data-action="next">Next</button>
        {{/if}}
      </div>
    </div>
    {{/if}}
  </div>

  <aside class="en-dossier" style="--rc: {{#if dossier.color}}{{dossier.color}}{{else}}var(--irop-teal, #3fb8b0){{/if}}">
    <span class="en-label">Personnel record, {{#if result}}filed{{else}}draft{{/if}}</span>
    <div class="en-ds-id">
      <div class="en-ds-portrait"><img src="{{dossier.img}}" alt=""></div>
      <div><div class="en-ds-name">{{dossier.name}}</div>
        <div class="en-ds-line">{{dossier.species}} {{#if dossier.role}}<b>{{dossier.role}}</b>{{/if}}</div></div>
    </div>
    <dl class="en-kv">
      <dt>Background</dt><dd class="{{#unless dossier.background}}pending{{/unless}}">{{#if dossier.background}}{{dossier.background}}{{else}}Pending{{/if}}</dd>
      <dt>Perk</dt><dd class="{{#unless dossier.perk}}pending{{/unless}}">{{#if dossier.perk}}{{dossier.perk}}{{else}}Pending{{/if}}</dd>
      <dt>Skills</dt><dd class="{{#unless dossier.skills}}pending{{/unless}}">{{#if dossier.skills}}{{dossier.skills}}{{else}}Pending{{/if}}</dd>
      {{#if dossier.grantsBoons}}<dt>Boons</dt><dd class="{{#unless dossier.boons}}pending{{/unless}}">{{#if dossier.boons}}{{dossier.boons}}{{else}}Pending{{/if}}</dd>{{/if}}
      {{#if dossier.carriesMutations}}<dt>Mutations</dt><dd class="{{#unless dossier.mutations}}pending{{/unless}}">{{#if dossier.mutations}}{{dossier.mutations}}{{else}}Pending{{/if}}</dd>{{/if}}
      {{#if dossier.training}}<dt>Training</dt><dd>{{dossier.training}}</dd>{{/if}}
      {{#if dossier.xp}}<dt>XP</dt><dd>{{dossier.xp}}</dd>{{/if}}
    </dl>
    {{#if dossier.bars.length}}
    <div class="en-vitals"><div>Health<b>{{dossier.health}}</b></div><div>Energy<b>{{dossier.energy}}</b></div></div>
    <div class="en-bars">{{#each dossier.bars as |a|}}<div class="en-bar {{#if a.boosted}}boosted{{/if}}">{{a.abbr}}<i><span style="width: {{a.pct}}%"></span></i><em>{{a.value}}</em></div>{{/each}}</div>
    {{else}}<p class="en-empty">Choose a species to see your attributes.</p>{{/if}}
  </aside>
</div>
