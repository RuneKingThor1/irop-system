<div class="irop-card item-card" {{#if accent}}style="--card-accent: {{accent}}"{{/if}}>
  <header class="card-head with-img">
    <img src="{{item.img}}" alt="">
    <div>
      <h3>{{item.name}}</h3>
      <span class="card-sub">{{typeLabel}}{{#if actionType}} · {{actionType}}{{/if}}{{#if discipline}} · {{discipline}}{{/if}}</span>
    </div>
  </header>
  {{#if (or spent ammoSpent system.range system.area)}}
  <div class="card-stats">
    {{#if spent}}<span class="stat-chip energy">{{spent}} Energy spent</span>{{/if}}
    {{#if ammoSpent}}<span class="stat-chip">{{ammoSpent}}</span>{{/if}}
    {{#if system.range}}<span class="stat-chip">Range {{system.range}}</span>{{/if}}
    {{#if system.area}}<span class="stat-chip">Area {{system.area}}</span>{{/if}}
  </div>
  {{/if}}
  <div class="card-description">{{{description}}}</div>
  {{#if powerLines.length}}<div class="card-upgrades power-lines">{{#each powerLines}}<p>{{this}}</p>{{/each}}</div>{{/if}}
  {{#if powerBarrier}}
  {{!-- A barrier it grants (2026-10-20): to the targeted tokens, or the caster. --}}
  <div class="card-buttons"><button type="button" data-irop-action="powerBarrier" data-tooltip="Target who gets it, or none for the caster, then press. It lifts a barrier to {{powerBarrier.amount}}, never on top.">
    <i class="fa-solid fa-shield"></i> Grant barrier {{powerBarrier.amount}}</button></div>
  {{/if}}
  {{#if powerSave}}
  {{!-- A save power: the target's owner targets it and rolls (2026-10-20). --}}
  <div class="card-buttons"><button type="button" data-irop-action="powerSave" data-tooltip="Target the token or tokens that must save, then press">
    <i class="fa-solid fa-shield-halved"></i> Roll {{powerSave.saveLabel}} save ({{powerSave.dmText}})</button></div>
  {{/if}}
  {{#if powerSave2}}
  {{!-- A second save (2026-10-29), such as Supernova's Blinded save for anyone who saw it. --}}
  <div class="card-buttons"><button type="button" data-irop-action="powerSave2" data-tooltip="{{powerSave2.label}}: target the token or tokens that must save, then press">
    <i class="fa-solid fa-eye-slash"></i> Roll {{powerSave2.saveLabel}} save: {{powerSave2.label}} ({{powerSave2.dmText}})</button></div>
  {{/if}}
  {{#if powerDamage}}
  {{!-- A save power's damage (2026-10-29), rolled by the caster. --}}
  <div class="card-buttons"><button type="button" data-irop-action="powerDamage" data-tooltip="{{powerDamage.formula}}: the power's text says what a save does to it">
    <i class="fa-solid fa-burst"></i> Roll damage ({{powerDamage.formula}})</button></div>
  {{/if}}
  {{#if perkLines.length}}<div class="card-upgrades"><p><strong>Perks:</strong> {{#each perkLines}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p></div>{{/if}}
  {{#if upgrades.length}}
  {{!-- What the character's upgrade perks add to it (2026-10-18). --}}
  <div class="card-upgrades">{{#each upgrades as |u|}}<p><strong>{{u.from}}:</strong> {{u.text}}</p>{{/each}}</div>
  {{/if}}
</div>
