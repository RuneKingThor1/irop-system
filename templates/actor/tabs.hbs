<nav class="sheet-tabs tabs" aria-roledescription="Sheet navigation">
  {{#each tabs as |tab|}}
  <a class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#if tab.icon}}<i class="{{tab.icon}}" inert></i>{{/if}}<span>{{tab.label}}</span>
  </a>
  {{/each}}
</nav>
