<section class="tab paraphysics {{tab.cssClass}}" data-group="primary" data-tab="paraphysics">
  {{!-- Its own tab (Johnald, 2026-10-16), only for a paraphysical character (and a GM in Edit mode, to set the first ranks).
        Paraphysics Framework Draft 0.6 (2026-10-18 and 19). Layout B with A's chip strip (Johnald, 2026-10-19):
        a slim strip of stats, the disciplines down the left, the picked discipline's powers on the right. --}}
  {{#with psi as |p|}}
  <div class="psi-strip">
    <span class="stat-chip" data-tooltip="The attribute paraphysical attacks roll under; its modifier sets the optimal range bonus">Casts on {{p.casting}}</span>
    {{#unless p.npc}}
    <span class="stat-chip psi-crystals" data-tooltip="{{p.crystalsTip}}. Psycrystals unlock a power (rank 1), evolve it (rank 5), and two awaken a person. They are loot: carried in Gear, found, bought and sold.">
      {{#if p.gm}}<button type="button" class="step" data-action="adjust" data-path="system.psi.crystals" data-delta="-1" data-tooltip="One fewer held back (carried ones are in Gear)"><i class="fa-solid fa-minus"></i></button>{{/if}}
      <i class="fa-solid fa-gem"></i> {{p.crystals}} psycrystal{{#unless (eq p.crystals 1)}}s{{/unless}}
      {{#if p.gm}}<button type="button" class="step" data-action="adjust" data-path="system.psi.crystals" data-delta="1" data-tooltip="Give one, held back on the character (or drop a Psycrystal item on them)"><i class="fa-solid fa-plus"></i></button>{{/if}}
    </span>
    {{/unless}}
    <span class="stat-chip" data-tooltip="Disciplines held, of how many the species can hold">Disciplines {{p.schools}}</span>
    {{#if p.concentrating}}<span class="stat-chip psi-concentrating" data-tooltip="Disorientated breaks it">
      <i class="fa-solid fa-brain"></i> Concentrating on {{p.concentrating}}
      <button type="button" class="step" data-action="endConcentration" data-tooltip="Let it go"><i class="fa-solid fa-xmark"></i></button></span>{{/if}}
    {{#if p.freePower}}<span class="stat-chip psi-free" data-tooltip="Drop a power of your awakened discipline on the sheet to learn it without a crystal"><i class="fa-solid fa-gift"></i> One power free</span>{{/if}}
    {{#if p.canAwaken}}<button type="button" class="attack psi-awaken" data-action="awaken" data-tooltip="Spend {{p.awakenCost}} psycrystals to awaken"><i class="fa-solid fa-atom"></i> Awaken</button>{{/if}}
  </div>

  <div class="psi-layout">
    <ol class="panel psi-sidebar">
      {{!-- Every power at once (Johnald, 2026-10-29), as well as by discipline. --}}
      <li class="psi-discipline psi-all {{#if p.all.selected}}selected{{/if}}" data-action="selectDiscipline" data-discipline="all"
        data-tooltip="Every power you hold, Tier 1 to 5" role="button" tabindex="0">
        <span class="psi-dname">All powers</span><span class="psi-count">{{p.all.slots}}</span>
      </li>
      {{#each p.disciplines as |d|}}
      <li class="psi-discipline {{#if d.selected}}selected{{/if}} {{#unless d.rank}}unranked{{/unless}} {{#unless d.open}}closed{{/unless}}"
        data-action="selectDiscipline" data-discipline="{{d.key}}" data-tooltip="{{d.owns}}" role="button" tabindex="0">
        <span class="psi-dname">{{d.label}}{{#unless d.open}} <span class="wave-tag">W2</span>{{/unless}}</span>
        <span class="pips psi-pips">
          {{#each d.pips as |pip|}}<button type="button" class="pip {{#if pip.filled}}filled{{/if}} {{#if pip.granted}}granted{{/if}} {{#if pip.buyable}}buyable{{/if}}"
            data-action="buyDiscipline" data-discipline="{{d.key}}" data-rank="{{pip.n}}" {{#if pip.buyable}}data-tooltip="Buy rank {{pip.n}}: {{pip.cost}} XP"{{/if}}
            {{#unless (or p.edit pip.buyable)}}disabled{{/unless}}></button>{{/each}}
        </span>
      </li>
      {{/each}}
    </ol>

    {{#with p.selected as |d|}}
    <div class="panel psi-main">
      <header class="panel-head">
        <h3>{{d.label}}</h3>
        {{#if d.all}}<span class="stat-chip" data-tooltip="Every power held, Tier 1 to 5">{{d.slots}} power{{#unless (eq d.slots "1")}}s{{/unless}}</span>
        {{else}}<span class="stat-chip {{#if d.full}}dim{{/if}}" data-tooltip="Powers held, of the rank's slots{{#if d.bonusText}}. Rank {{d.rank}}, {{d.bonusText}}{{/if}}">{{d.slots}} powers</span>{{/if}}
      </header>
      {{!-- Tier bands and stat block cards (Johnald, 2026-10-29): powers under Tier 1 to 5 headers; each
            card a name line with its pips and Cast, a ribbon of labeled stats, and its picks by rank. --}}
      {{#each d.tiers as |band|}}
      <h4 class="psi-tier-band">{{band.label}}</h4>
      <ol class="item-list psi-powers">
        {{#each band.powers as |w|}}
        <li class="item-row power-row power-card ability-row draggable {{#if w.expanded}}expanded{{/if}}" data-item-id="{{w.id}}" data-discipline="{{w.discipline}}">
          <div class="power-head">
            <img class="item-img power-img" src="{{w.img}}" alt="" data-action="editItem" data-tooltip="Open the power">
            <div class="item-name summary-toggle" data-action="toggleSummary" role="button" tabindex="0" aria-expanded="{{#if w.expanded}}true{{else}}false{{/if}}">
              <span class="ability-name power-name">{{w.name}}<i class="fa-solid fa-chevron-down summary-chevron" inert></i></span>
              <span class="item-sub power-sub">{{#if w.formerly}}Evolved from {{w.formerly}} · {{/if}}{{#if d.all}}{{w.disciplineLabel}} · {{/if}}Tier {{w.tier}}{{#if w.kind}} · {{w.kind}}{{/if}}{{#if w.concentration}} · <span data-tooltip="Disorientated breaks it">Concentration</span>{{/if}}</span>
            </div>
            <span class="pips power-pips">
              {{#each w.pips as |pip|}}<button type="button" class="pip {{#if pip.filled}}filled{{/if}} {{#if pip.crystal}}crystal{{/if}} {{#if pip.choice}}choice{{/if}} {{#if pip.buyable}}buyable{{/if}}"
                data-action="buyPowerRank" data-rank="{{pip.n}}" data-tooltip="{{pip.tip}}"
                {{#unless (or pip.editable pip.buyable)}}disabled{{/unless}}></button>{{/each}}
            </span>
            <div class="row-controls">
              <button type="button" class="attack" data-action="useItem"><i class="fa-solid fa-{{#if w.attack}}crosshairs{{else}}bolt{{/if}}"></i> {{#if w.attack}}Cast{{else}}Use{{/if}}</button>
              {{#if @root.editable}}<button type="button" class="icon" data-action="deleteItem" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>{{/if}}
            </div>
          </div>
          <dl class="power-stats">
            {{#each w.stats as |st|}}
            <div class="power-stat stat-{{st.key}} {{#if st.changed}}from-perks{{/if}}" data-tooltip="{{st.tip}}">
              <dt>{{st.label}}</dt><dd>{{st.value}}{{#if st.type}} <span class="stat-type">{{st.type}}</span>{{/if}}</dd>
            </div>
            {{/each}}
          </dl>
          {{!-- A rank held without its pick: one button opens the pick popup (2026-10-29). --}}
          {{#if (or w.choosing w.evolving)}}
          <div class="power-choice">
            {{#if w.choosing}}<button type="button" class="ghost" data-action="choosePower" data-kind="option"><i class="fa-solid fa-star"></i> Choose the Rank 3 modification</button>{{/if}}
            {{#if w.evolving}}<button type="button" class="ghost" data-action="choosePower" data-kind="evolution"><i class="fa-solid fa-star"></i> Choose the Rank 5 evolution</button>{{/if}}
          </div>
          {{/if}}
          {{#if w.noChoices}}<p class="hint power-note">This power offers no Rank 3 modifications yet.</p>{{/if}}
          {{#each w.picks as |pk|}}
          <p class="power-pick rank-{{pk.rank}}"><span class="mono-label">Rank {{pk.rank}} · {{pk.label}}</span> {{pk.text}}</p>
          {{/each}}
          {{!-- The power's text, dropped down from its name (2026-10-20). --}}
          <div class="ability-summary">
            <div class="summary-body">
              {{#if w.descriptionHTML}}{{{w.descriptionHTML}}}{{else}}<p class="hint">No description yet.</p>{{/if}}
            </div>
          </div>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <ol class="item-list psi-powers">
        <li class="empty-row">{{#if d.all}}No powers yet. Drop one on the sheet to learn it.{{else if d.rank}}No {{d.label}} powers yet. Drop one on the sheet to learn it.{{else}}Buy rank 1 to open {{d.label}}.{{/if}}</li>
      </ol>
      {{/each}}
    </div>
    {{/with}}
  </div>
  {{/with}}
</section>
