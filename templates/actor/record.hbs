<div class="irop-record-dock page-{{record.page}} {{#if record.open}}open{{/if}}"
     {{#if record.roleColor}}style="--record-role: {{record.roleColor}}"{{/if}}>
{{#unless record.only}}
<div class="record-gutter">
  <button type="button" class="record-bar record-tab {{#if record.recordActive}}active{{/if}}" data-action="toggleRecord"
          aria-expanded="{{#if record.recordActive}}true{{else}}false{{/if}}"
          data-tooltip="{{#if record.recordActive}}Close the Personnel Record{{else}}Open the Personnel Record{{/if}}">
    <i class="fa-solid {{record.barIcon}}" inert></i>
    <span class="bar-label">Record</span>
    <i class="fa-solid {{record.barIcon}}" inert></i>
  </button>
  {{!-- The owner's Notes, off the tab bar and onto a side tab of their own (Johnald, 2026-10-11). --}}
  <button type="button" class="record-bar notes-tab {{#if record.notesActive}}active{{/if}}" data-action="toggleNotes"
          aria-expanded="{{#if record.notesActive}}true{{else}}false{{/if}}"
          data-tooltip="{{#if record.notesActive}}Close your Notes{{else}}Open your Notes{{/if}}">
    <i class="fa-solid {{record.notesBarIcon}}" inert></i>
    <span class="bar-label">Notes</span>
    <i class="fa-solid {{record.notesBarIcon}}" inert></i>
  </button>
</div>
{{/unless}}
<aside class="irop-record" aria-hidden="{{#if record.open}}false{{else}}true{{/if}}">
  <div class="record-body">

    <header class="record-head">
      <div class="record-head-band">
        <div class="record-title">
          <span class="record-name">{{record.title}}</span>
          <span class="record-number"><span class="record-cursor"></span>{{record.number}}</span>
        </div>
        <ol class="record-log">
          {{#each record.log as |line|}}<li>{{line}}</li>{{#unless @last}}<li class="sep">///</li>{{/unless}}{{/each}}
        </ol>
      </div>
      {{#if record.only}}<div class="record-head-tabs"><span class="record-tag">Read only</span></div>{{/if}}
    </header>

    <section class="record-identity">
      {{!-- The photo, framed as its owner set it (2026-10-16): drag to move, zoom with the slider or wheel. --}}
      <div class="record-portrait-frame {{#if record.adjusting}}adjusting{{/if}}" data-portrait-frame
        style="--px: {{record.frame.x}}%; --py: {{record.frame.y}}%; --pz: {{record.frame.scale}};">
        <img class="record-portrait" src="{{record.photo}}" alt="{{actor.name}}" draggable="false" data-irop-preview>
        {{#if record.canFrame}}
        {{#if record.adjusting}}
        {{!-- Zoom down the right side, tall, plus at the top (Johnald, 2026-10-16). --}}
        <div class="portrait-zoom">
          <i class="fa-solid fa-magnifying-glass-plus"></i>
          <input type="range" min="100" max="300" step="5" value="{{record.frame.zoom}}" data-portrait-zoom aria-label="Zoom">
          <i class="fa-solid fa-magnifying-glass-minus"></i>
        </div>
        <div class="portrait-adjust-bar">
          <span>Drag to move</span>
          <button type="button" data-action="recordPhoto" data-tooltip="A photo for the record only; the sheet's portrait stays as it is">Change photo</button>
          <button type="button" data-action="resetPortrait">Reset</button>
          <button type="button" class="done" data-action="framePortrait">Done</button>
        </div>
        {{else}}
        <button type="button" class="portrait-adjust-btn" data-action="framePortrait" data-tooltip="Move and zoom the photo" aria-label="Move and zoom the photo"><i class="fa-solid fa-crop-simple"></i></button>
        {{/if}}
        {{/if}}
      </div>
    </section>

    <section class="record-pair">
      <div class="record-panel record-fields">
        <dl>
          {{#each record.identity as |f|}}
          <div class="record-line {{#if f.indent}}indent{{/if}}"><dt>{{f.label}}:</dt>
            <dd><input type="text" name="system.details.record.{{f.key}}" value="{{f.value}}" placeholder="{{f.placeholder}}"
                       {{#unless @root.editable}}disabled{{/unless}}></dd></div>
          {{/each}}
        </dl>
        <label class="record-stack"><span>Distinguishing marks</span>
          <textarea name="system.details.record.marks" rows="2" placeholder="scars, tattoos, implants"
                    {{#unless editable}}disabled{{/unless}}>{{record.marks}}</textarea></label>
      </div>

      {{!-- Johnald, 2026-10-08: the role's emblem on top, the rank below, where Biometrics was. --}}
      <div class="record-panel record-insignia">
        <div class="record-emblem">
          <h4>Doctrine</h4>
          {{#if role}}
          <img class="record-emblem-img" src="{{role.img}}" alt="{{role.name}}">
          <span class="record-insignia-name doctrine">{{role.name}}</span>
          {{else}}
          <i class="fa-solid fa-shield-halved record-emblem-none" inert></i>
          <span class="record-insignia-name"><em>unassigned</em></span>
          {{/if}}
        </div>
        {{!-- The ODR rank (2026-10-17): by XP earned, or set by the GM. --}}
        <div class="record-rank" data-tooltip="{{record.rank.band}}. Next: {{record.rank.nextLine}}">
          <h4>Rank</h4>
          <img class="record-rank-img" src="{{record.rank.insignia}}" alt="{{record.rank.label}} insignia" data-irop-preview>
          <span class="record-insignia-name">{{record.rank.label}}</span>
          <span class="record-rank-band">{{#if record.rank.set}}Set by the GM{{else}}{{record.rank.band}}{{/if}}</span>
          {{#if record.rank.choices}}
          <select class="record-rank-set" name="system.details.record.rank" data-tooltip="By XP earned follows the bands; a rank picked here holds until set back">
            {{#each record.rank.choices as |c|}}<option value="{{c.key}}" {{#if c.on}}selected{{/if}}>{{c.label}}</option>{{/each}}
          </select>
          {{/if}}
        </div>
      </div>
    </section>

    <section class="record-panel record-service">
      <h4>Service</h4>
      <dl>
        {{#if system.details.callsign}}<div class="record-line"><dt>Callsign:</dt><dd>{{system.details.callsign}}</dd></div>{{/if}}
        <div class="record-line"><dt>Species:</dt><dd>{{#if species}}{{species.name}}{{else}}<em>unrecorded</em>{{/if}}</dd></div>
        <div class="record-line"><dt>Background:</dt>
          <dd>{{#if background}}<a data-action="editItem" data-item-id="{{background.id}}">{{background.name}}</a>{{else}}<em>unrecorded</em>{{/if}}</dd></div>
        {{#each record.service as |f|}}
        <div class="record-line"><dt>{{f.label}}:</dt>
          <dd><input type="text" name="system.details.record.{{f.key}}" value="{{f.value}}" placeholder="{{f.placeholder}}"
                     {{#unless @root.editable}}disabled{{/unless}}></dd></div>
        {{/each}}
        <div class="record-line"><dt>Next of kin:</dt>
          <dd class="kin">
            <input type="text" name="system.details.record.nextOfKin.name" value="{{record.nextOfKin.name}}" placeholder="name"
                   {{#unless editable}}disabled{{/unless}}>
            <input type="text" name="system.details.record.nextOfKin.relation" value="{{record.nextOfKin.relation}}" placeholder="relation"
                   {{#unless editable}}disabled{{/unless}}>
          </dd></div>
      </dl>
    </section>

    {{!-- Medals (Johnald, 2026-10-17): no art, a ribbon in the ODR colors, why and on what mission. --}}
    <section class="record-panel record-medals">
      <header class="record-bio-head">
        <h4>Commendations</h4>
        {{#if record.canAward}}<button type="button" class="record-btn small" data-action="awardMedal"><i class="fa-solid fa-medal" inert></i> Award medal</button>{{/if}}
      </header>
      <ol class="record-medal-list">
        {{#each record.medals as |m|}}
        <li class="record-medal" data-medal-id="{{m.id}}">
          <span class="medal-ribbon" style="{{m.ribbon}}"></span>
          <div class="medal-body">
            <span class="medal-name">{{m.name}}</span>
            {{#if (or m.mission m.date)}}<span class="medal-meta">{{m.mission}}{{#if (and m.mission m.date)}}, {{/if}}{{m.date}}</span>{{/if}}
            {{#if m.description}}<p class="medal-why">{{m.description}}</p>{{/if}}
          </div>
          {{#if @root.record.canAward}}
          <span class="medal-controls">
            <button type="button" class="icon" data-action="editMedal" data-tooltip="Edit medal"><i class="fa-solid fa-pen" inert></i></button>
            <button type="button" class="icon" data-action="removeMedal" data-tooltip="Remove medal"><i class="fa-solid fa-xmark" inert></i></button>
          </span>
          {{/if}}
        </li>
        {{else}}
        <li class="record-empty">No commendations on file.</li>
        {{/each}}
      </ol>
    </section>

    <section class="record-panel record-bio">
      <h4>Bio:</h4>
      <prose-mirror class="record-biography" name="system.details.biography" value="{{system.details.biography}}" toggled>{{{biography}}}</prose-mirror>
      <header class="record-bio-head">
        <h5>Service log</h5>
        {{#if editable}}<button type="button" class="record-btn small" data-action="addRecordEntry"><i class="fa-solid fa-plus" inert></i> Add entry</button>{{/if}}
      </header>
      <ol class="record-timeline">
        {{#each record.timeline as |e|}}
        <li class="record-entry" data-record-index="{{e.index}}">
          <input type="text" class="record-date" value="{{e.date}}" placeholder="date" data-record-field="date"
                 {{#unless @root.editable}}disabled{{/unless}}>
          <textarea class="record-text" rows="2" placeholder="what happened" data-record-field="entry"
                    {{#unless @root.editable}}disabled{{/unless}}>{{e.entry}}</textarea>
          {{#if @root.editable}}<button type="button" class="icon" data-action="deleteRecordEntry" data-tooltip="Delete entry"><i class="fa-solid fa-xmark" inert></i></button>{{/if}}
        </li>
        {{else}}
        <li class="record-empty">No entries on file.</li>
        {{/each}}
      </ol>
    </section>

  </div>
  {{#unless record.only}}
  {{!-- The owner's Notes: theirs and the GM's alone, since anyone else sees the record by itself. --}}
  <section class="drawer-notes">
    <header class="drawer-notes-head">
      <span class="drawer-notes-title">Notes</span>
      <span class="drawer-notes-sub">Private: owners and the GM</span>
    </header>
    <prose-mirror class="drawer-notes-editor" name="system.details.notes" value="{{system.details.notes}}" toggled>{{{notes}}}</prose-mirror>
  </section>
  {{/unless}}
</aside>
</div>
